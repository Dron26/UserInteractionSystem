@page "/clients/{id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@inject UserInteractionSystem.Application.Services.ClientService ClientService
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer

<PageTitle>Карточка клиента</PageTitle>

<h1>Карточка клиента</h1>

@if (client is null)
{
    <p>Клиент не найден</p>
}
else
{
    <dl>
        <dt>ФИО</dt>
        <dd>@client.FullName</dd>

        <dt>Телефон</dt>
        <dd>@client.Phone</dd>

        <dt>Email</dt>
        <dd>@client.Email</dd>

        <dt>Комментарий</dt>
        <dd>@client.Comment</dd>

        <dt>Дата создания</dt>
        <dd>@client.CreatedAt</dd>
    </dl>

    @if (client.IsArchived)
    {
        <p>Клиент архивирован.</p>
    }
    else if (!isEditing)
    {
        <button type="button" @onclick="StartEditing">Редактировать</button>
    }

    @if (!string.IsNullOrWhiteSpace(operationMessage))
    {
        <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")" role="alert">
            @operationMessage
        </div>
    }

    @if (isEditing && editClient is not null)
    {
        <EditForm Model="editClient"
          OnValidSubmit="SaveClient"
          FormName="edit-client-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label>ФИО</label>
                <InputText @bind-Value="editClient.FullName" />
                <ValidationMessage For="@(() => editClient.FullName)" />
            </div>

            <div>
                <label>Телефон</label>
                <InputText @bind-Value="editClient.Phone" />
                <ValidationMessage For="@(() => editClient.Phone)" />
            </div>

            <div>
                <label>Email</label>
                <InputText @bind-Value="editClient.Email" />
                <ValidationMessage For="@(() => editClient.Email)" />
            </div>

            <div>
                <label>Комментарий</label>
                <InputTextArea @bind-Value="editClient.Comment" />
                <ValidationMessage For="@(() => editClient.Comment)" />
            </div>

            <button type="submit">Сохранить</button>
            <button type="button" @onclick="CancelEditing">Отмена</button>
        </EditForm>
    }
}

@code {
    [Parameter]
    public int id { get; set; }

    private UserInteractionSystem.Domain.Entities.Client? client;
    private UserInteractionSystem.Domain.Entities.Client? editClient;
    private bool isEditing;
    private bool operationSucceeded;
    private string? operationMessage;

    protected override async Task OnInitializedAsync()
    {
        client = await ClientService.GetClientByIdAsync(id);
    }

    private void StartEditing()
    {
        if (client is null || client.IsArchived)
        {
            return;
        }

        editClient = new UserInteractionSystem.Domain.Entities.Client
        {
            Id = client.Id,
            FullName = client.FullName,
            Phone = client.Phone,
            Email = client.Email,
            Comment = client.Comment,
            CreatedAt = client.CreatedAt,
            IsArchived = client.IsArchived
        };

        isEditing = true;
    }

    private async Task SaveClient()
    {
        if (editClient is null)
        {
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operationSucceeded = await ClientService.UpdateClientAsync(editClient, authenticationState.User);
        operationMessage = operationSucceeded
            ? "Данные клиента сохранены."
            : "Не удалось сохранить изменения. Проверьте данные и актуальность учётной записи: активность и роль.";

        if (operationSucceeded)
        {
            client = await ClientService.GetClientByIdAsync(id);
            editClient = null;
            isEditing = false;
        }
    }

    private void CancelEditing()
    {
        editClient = null;
        isEditing = false;
    }
}
