@page "/change-password"
@layout UserInteractionSystem.Components.Layout.AccountLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserInteractionSystem.Application.Services.UserService UserService

<PageTitle>Обязательная смена пароля</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <section class="card">
            <div class="card-header">
                <h1 class="h4 mb-0">Смена временного пароля</h1>
            </div>
            <div class="card-body">
                @if (mustChangePassword == true)
                {
                    <p>Установите новый пароль, чтобы продолжить работу. Временный пароль действует 15 минут.</p>
                    @if (error)
                    {
                        <div class="alert alert-danger" role="alert">
                            Не удалось изменить пароль. Проверьте, что пароли совпадают, содержат не менее 8 символов и временный пароль не истёк.
                        </div>
                    }

                    <form method="post" action="/account/change-password" data-enhance="false">
                        <input type="hidden" name="__RequestVerificationToken" value="@requestToken" />
                        <div class="mb-3">
                            <label class="form-label" for="new-password">Новый пароль</label>
                            <input id="new-password" class="form-control" name="newPassword" type="password" autocomplete="new-password" minlength="8" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="confirm-password">Повторите пароль</label>
                            <input id="confirm-password" class="form-control" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required />
                        </div>
                        <button class="btn btn-primary" type="submit">Сохранить новый пароль</button>
                    </form>
                }
                else if (mustChangePassword == false)
                {
                    <div class="alert alert-info" role="status">Обязательная смена пароля не требуется.</div>
                    <a class="btn btn-primary" href="/" data-enhance-nav="false">Перейти в систему</a>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        Сеанс недействителен или срок временного пароля истёк. Войдите снова и запросите новый временный пароль у администратора.
                    </div>
                    <a class="btn btn-primary" href="/login" data-enhance-nav="false">Перейти ко входу</a>
                }
            </div>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public bool Error { get; set; }

    private string? requestToken;
    private bool? mustChangePassword;
    private bool error;

    protected override void OnInitialized()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context is not null)
        {
            requestToken = Antiforgery.GetAndStoreTokens(context).RequestToken;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        error = Error;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        mustChangePassword = await UserService.GetPasswordChangeRequirementAsync(authenticationState.User);
    }
}
