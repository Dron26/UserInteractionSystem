@page "/clients"
@inject UserInteractionSystem.Application.Services.ClientService ClientService
@using UserInteractionSystem.Domain.Entities
@rendermode InteractiveServer

<PageTitle>Клиенты</PageTitle>

<h1>Клиенты</h1>
<EditForm Model="newClient" OnValidSubmit="AddClient" FormName="client-form">
    
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>ФИО</label>
        <InputText @bind-Value="newClient.FullName" />
        <ValidationMessage For="@(() => newClient.FullName)" />
    </div>

    <div>
        <label>Телефон</label>
        <InputText @bind-Value="newClient.Phone" />
    </div>

    <div>
        <label>Email</label>
        <InputText @bind-Value="newClient.Email" />
        <ValidationMessage For="@(() => newClient.Email)" />
    </div>

    <div>
        <label>Комментарий</label>
        <InputTextArea @bind-Value="newClient.Comment" />
    </div>

    <button type="submit">Добавить клиента</button>
</EditForm>



@if (clients.Count == 0)
{
    <p>Клиенты отсутствуют.</p>
}
else
{
    <ul>
        @foreach (var client in clients)
        {
            <li>
                <div><a href="@($"/clients/{client.Id}")">@client.FullName</a></div>
                <div>@client.Phone</div>
                <div>@client.Email</div>
                <button type="button" @onclick="() => ArchiveClient(client.Id)">Архивировать</button>
            </li>
        }
    </ul>
}

@code {
    private List<Client> clients = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private Client newClient = new()
        {
            FullName = string.Empty
        };

    private async Task LoadClients()
    {
        clients = await ClientService.GetClientsAsync();
    }

    private async Task AddClient()
    {
        newClient.CreatedAt = DateTime.UtcNow;
        newClient.IsArchived = false;

        await ClientService.AddClientAsync(newClient);

        await LoadClients();

        newClient = new Client
        {
            FullName = string.Empty
        };
    }

    private async Task ArchiveClient(int clientId)
    {
        var archived = await ClientService.ArchiveClientAsync(clientId);

        if (archived)
        {
            await LoadClients();
        }
    }
}

