@page "/clients"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@inject UserInteractionSystem.Application.Services.ClientService ClientService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using UserInteractionSystem.Domain.Entities
@rendermode InteractiveServer

<PageTitle>Клиенты</PageTitle>

<h1>Клиенты</h1>
<EditForm Model="newClient" OnValidSubmit="AddClient" FormName="client-form">
    
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>ФИО</label>
        <InputText @bind-Value="newClient.FullName" />
        <ValidationMessage For="@(() => newClient.FullName)" />
    </div>

    <div>
        <label>Телефон</label>
        <InputText @bind-Value="newClient.Phone" />
    </div>

    <div>
        <label>Email</label>
        <InputText @bind-Value="newClient.Email" />
        <ValidationMessage For="@(() => newClient.Email)" />
    </div>

    <div>
        <label>Комментарий</label>
        <InputTextArea @bind-Value="newClient.Comment" />
    </div>

    <button type="submit">Добавить клиента</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(operationMessage))
{
    <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")" role="alert">
        @operationMessage
    </div>
}

<div>
    <label for="client-search">Поиск по имени</label>
    <input id="client-search" type="text" placeholder="Поиск по имени" @bind="searchText" @bind:event="oninput" />
</div>


@if (clients.Count == 0)
{
    <p>Клиенты отсутствуют.</p>
}
else if (!filteredClients.Any())
{
    <p>Клиенты не найдены</p>
}
else
{
    <ul>
        @foreach (var client in filteredClients)
        {
            <li>
                <div><a href="@($"/clients/{client.Id}")">@client.FullName</a></div>
                <div>@client.Phone</div>
                <div>@client.Email</div>
                <button type="button" @onclick="() => ArchiveClient(client.Id)">Архивировать</button>
            </li>
        }
    </ul>
}

@code {
    private List<Client> clients = [];
    private string searchText = string.Empty;
    private bool operationSucceeded;
    private string? operationMessage;

    private IEnumerable<Client> filteredClients => string.IsNullOrWhiteSpace(searchText)
        ? clients
        : clients.Where(client => client.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private Client newClient = new()
        {
            FullName = string.Empty
        };

    private async Task LoadClients()
    {
        clients = await ClientService.GetClientsAsync();
    }

    private async Task AddClient()
    {
        newClient.CreatedAt = DateTime.UtcNow;
        newClient.IsArchived = false;

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operationSucceeded = await ClientService.AddClientAsync(newClient, authenticationState.User);
        operationMessage = operationSucceeded
            ? "Клиент создан."
            : "Не удалось создать клиента. Проверьте данные и актуальность учётной записи: активность и роль.";

        if (operationSucceeded)
        {
            await LoadClients();
            newClient = new Client { FullName = string.Empty };
        }
    }

    private async Task ArchiveClient(int clientId)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operationSucceeded = await ClientService.ArchiveClientAsync(clientId, authenticationState.User);
        operationMessage = operationSucceeded
            ? "Клиент архивирован."
            : "Не удалось архивировать клиента. Проверьте актуальность учётной записи: активность и роль.";

        if (operationSucceeded)
        {
            await LoadClients();
        }
    }
}

