@page "/clients"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using UserInteractionSystem.Application.Models
@inject UserInteractionSystem.Application.Services.ClientService ClientService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using UserInteractionSystem.Domain.Entities
@rendermode InteractiveServer

<PageTitle>Клиенты</PageTitle>

<h1>Клиенты</h1>
<section class="card client-create-panel mb-4" aria-labelledby="client-create-heading">
    <div class="card-header">
        <h2 id="client-create-heading" class="h5 mb-0">&#1044;&#1086;&#1073;&#1072;&#1074;&#1080;&#1090;&#1100; &#1082;&#1083;&#1080;&#1077;&#1085;&#1090;&#1072;</h2>
    </div>
    <div class="card-body">
        <EditForm Model="newClient" OnValidSubmit="AddClient" FormName="client-form" class="client-create-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="mb-3">
                <label class="form-label" for="new-client-full-name">&#1060;&#1048;&#1054; <span class="text-danger" aria-hidden="true">*</span></label>
                <InputText id="new-client-full-name" class="form-control" @bind-Value="newClient.FullName" />
                <ValidationMessage For="@(() => newClient.FullName)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="new-client-phone">&#1058;&#1077;&#1083;&#1077;&#1092;&#1086;&#1085;</label>
                <InputText id="new-client-phone" class="form-control" @bind-Value="newClient.Phone" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="new-client-email">Email</label>
                <InputText id="new-client-email" class="form-control" @bind-Value="newClient.Email" />
                <ValidationMessage For="@(() => newClient.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="new-client-comment">&#1050;&#1086;&#1084;&#1084;&#1077;&#1085;&#1090;&#1072;&#1088;&#1080;&#1081;</label>
                <InputTextArea id="new-client-comment" class="form-control" @bind-Value="newClient.Comment" />
            </div>

            <button type="submit" class="btn btn-primary me-2">&#1044;&#1086;&#1073;&#1072;&#1074;&#1080;&#1090;&#1100; &#1082;&#1083;&#1080;&#1077;&#1085;&#1090;&#1072;</button>
            <a class="btn btn-outline-secondary" href="/clients">&#1054;&#1090;&#1084;&#1077;&#1085;&#1072;</a>
        </EditForm>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(operationMessage))
{
    <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")" role="alert">
        @operationMessage
    </div>
}

<section class="card client-filter-panel mb-4" aria-label="Поиск клиентов">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="h5 mb-0">&#1060;&#1080;&#1083;&#1100;&#1090;&#1088;&#1099; &#1082;&#1083;&#1080;&#1077;&#1085;&#1090;&#1086;&#1074;</h2>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetFiltersAsync">&#1057;&#1073;&#1088;&#1086;&#1089;&#1080;&#1090;&#1100; &#1092;&#1080;&#1083;&#1100;&#1090;&#1088;&#1099;</button>
        </div>
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label client-filter-label" for="client-name-filter">ФИО</label>
                <input id="client-name-filter" class="form-control" type="search" placeholder="Поиск по ФИО"
                       @bind="filter.FullName" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label client-filter-label" for="client-phone-filter">Телефон</label>
                <input id="client-phone-filter" class="form-control" type="search" placeholder="Поиск по телефону"
                       @bind="filter.Phone" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label client-filter-label" for="client-email-filter">Email</label>
                <input id="client-email-filter" class="form-control" type="search" placeholder="Поиск по email"
                       @bind="filter.Email" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label client-filter-label" for="client-comment-filter">Комментарий</label>
                <input id="client-comment-filter" class="form-control" type="search" placeholder="Поиск в комментариях"
                       @bind="filter.Comment" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label client-filter-label" for="client-period-filter">Дата создания</label>
                <select id="client-period-filter" class="form-select" @bind="filter.Period" @bind:after="ApplyFiltersAsync">
                    <option value="@ClientDatePeriod.AllTime">Всё время</option>
                    <option value="@ClientDatePeriod.Today">Сегодня</option>
                    <option value="@ClientDatePeriod.LastWeek">Последняя неделя</option>
                    <option value="@ClientDatePeriod.LastMonth">Последний месяц</option>
                    <option value="@ClientDatePeriod.Custom">Произвольный диапазон</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label client-filter-label" for="client-archive-filter">&#1057;&#1086;&#1089;&#1090;&#1086;&#1103;&#1085;&#1080;&#1077;</label>
                <select id="client-archive-filter" class="form-select" @bind="filter.ArchiveState" @bind:after="ApplyFiltersAsync">
                    <option value="@ClientArchiveFilter.Active">&#1040;&#1082;&#1090;&#1080;&#1074;&#1085;&#1099;&#1077;</option>
                    <option value="@ClientArchiveFilter.Archived">&#1040;&#1088;&#1093;&#1080;&#1074;&#1085;&#1099;&#1077;</option>
                    <option value="@ClientArchiveFilter.All">&#1042;&#1089;&#1077; &#1082;&#1083;&#1080;&#1077;&#1085;&#1090;&#1099;</option>
                </select>
            </div>
            @if (filter.Period == ClientDatePeriod.Custom)
            {
                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label client-filter-label" for="client-from-date">Начало периода</label>
                    <input id="client-from-date" class="form-control" type="date" @bind="filter.FromDate"
                           @bind:after="ApplyFiltersAsync" />
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label client-filter-label" for="client-to-date">Окончание периода</label>
                    <input id="client-to-date" class="form-control" type="date" @bind="filter.ToDate"
                           @bind:after="ApplyFiltersAsync" />
                </div>
            }
        </div>
        @if (filterError is not null)
        {
            <div class="alert alert-warning mt-3 mb-0" role="alert">@filterError</div>
        }
    </div>
</section>

@if (clients.Count == 0 && !HasActiveFilters)
{
    <p class="text-muted">&#1055;&#1086;&#1082;&#1072; &#1085;&#1077;&#1090; &#1072;&#1082;&#1090;&#1080;&#1074;&#1085;&#1099;&#1093; &#1082;&#1083;&#1080;&#1077;&#1085;&#1090;&#1086;&#1074;.</p>
}
else if (clients.Count == 0)
{
    <p>Клиенты не найдены</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var client in clients)
        {
            <div class="col" @key="client.Id">
                <article class="card h-100 client-card @(client.IsArchived ? "client-card-archived" : null)">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            @if (client.IsArchived)
                            {
                                <span class="badge client-status-badge client-status-archived">Архивный</span>
                            }
                            else
                            {
                                <span class="badge client-status-badge client-status-active">Активный</span>
                            }
                        </div>
                        <h2 class="h5 client-card-title mb-3"><a class="text-decoration-none" href="@($"/clients/{client.Id}")">@client.FullName</a></h2>
                        @if (!string.IsNullOrWhiteSpace(client.Phone))
                        {
                            <div class="client-card-detail mb-3">
                                <div class="client-card-label">Телефон</div>
                                <div><a href="@($"tel:{client.Phone}")">@client.Phone</a></div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(client.Email))
                        {
                            <div class="client-card-detail mb-3">
                                <div class="client-card-label">Электронная почта</div>
                                <div><a href="@($"mailto:{client.Email}")">@client.Email</a></div>
                            </div>
                        }
                        <div class="client-card-footer mt-auto">
                            <time class="client-card-date" datetime="@client.CreatedAt.ToString("O")">&#1057;&#1086;&#1079;&#1076;&#1072;&#1085;&#1072;: <span class="client-card-date-value">@client.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span></time>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a class="btn btn-outline-primary btn-sm client-details-button" href="@($"/clients/{client.Id}")">&#1054;&#1090;&#1082;&#1088;&#1099;&#1090;&#1100; &#1082;&#1072;&#1088;&#1090;&#1086;&#1095;&#1082;&#1091;</a>
                                @if (client.IsArchived)
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => RestoreClient(client.Id)">&#1042;&#1086;&#1089;&#1089;&#1090;&#1072;&#1085;&#1086;&#1074;&#1080;&#1090;&#1100;</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm client-archive-button" aria-label="Archive client" title="Archive client" @onclick="() => ArchiveClient(client.Id)">&#1040;&#1088;&#1093;&#1080;&#1074;&#1080;&#1088;&#1086;&#1074;&#1072;&#1090;&#1100;</button>
                                }
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }

@code {
    private List<Client> clients = [];
    private ClientListFilter filter = new();
    private bool operationSucceeded;
    private string? operationMessage;
    private string? filterError;

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private Client newClient = new()
        {
            FullName = string.Empty
        };

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(filter.FullName) ||
        !string.IsNullOrWhiteSpace(filter.Phone) ||
        !string.IsNullOrWhiteSpace(filter.Email) ||
        !string.IsNullOrWhiteSpace(filter.Comment) ||
        filter.Period != ClientDatePeriod.AllTime ||
        filter.ArchiveState != ClientArchiveFilter.Active;

    private async Task LoadClients()
    {
        clients = await ClientService.GetClientsAsync(filter);
    }

    private async Task ApplyFiltersAsync()
    {
        filterError = null;
        if (filter.Period == ClientDatePeriod.Custom &&
            filter.FromDate.HasValue &&
            filter.ToDate.HasValue &&
            filter.FromDate.Value.Date > filter.ToDate.Value.Date)
        {
            filterError = "Дата окончания периода должна быть не раньше даты начала.";
            clients = [];
            return;
        }

        await LoadClients();
    }

    private async Task ResetFiltersAsync()
    {
        filter = new ClientListFilter();
        await ApplyFiltersAsync();
    }

    private async Task AddClient()
    {
        newClient.CreatedAt = DateTime.UtcNow;
        newClient.IsArchived = false;

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operationSucceeded = await ClientService.AddClientAsync(newClient, authenticationState.User);
        operationMessage = operationSucceeded
            ? "Клиент создан."
            : "Не удалось создать клиента. Проверьте данные и актуальность учётной записи: активность и роль.";

        if (operationSucceeded)
        {
            await LoadClients();
            newClient = new Client { FullName = string.Empty };
        }
    }

    private async Task ArchiveClient(int clientId)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operationSucceeded = await ClientService.ArchiveClientAsync(clientId, authenticationState.User);
        operationMessage = operationSucceeded
            ? "\u041A\u043B\u0438\u0435\u043D\u0442 \u0430\u0440\u0445\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D."
            : "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0430\u0440\u0445\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u0430. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043F\u0440\u0430\u0432\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u0438 \u0447\u0442\u043E \u043A\u043B\u0438\u0435\u043D\u0442 \u0435\u0449\u0451 \u043D\u0435 \u0430\u0440\u0445\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D.";

        if (operationSucceeded)
        {
            await LoadClients();
        }
    }

    private async Task RestoreClient(int clientId)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operationSucceeded = await ClientService.RestoreClientAsync(clientId, authenticationState.User);
        operationMessage = operationSucceeded
            ? "\u041A\u043B\u0438\u0435\u043D\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D."
            : "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u0430. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043F\u0440\u0430\u0432\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u0438 \u0447\u0442\u043E \u043A\u043B\u0438\u0435\u043D\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0430\u0440\u0445\u0438\u0432\u0435.";

        if (operationSucceeded)
        {
            await LoadClients();
        }
    }
}

