@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using UserInteractionSystem.Application.Models
@using UserInteractionSystem.Domain.Enums
@inject UserInteractionSystem.Application.Services.UserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Сотрудники</PageTitle>

<h1>Сотрудники</h1>

@if (isFirstUser)
{
    <div class="alert alert-info" role="status">
        Пользователей пока нет. Создайте первого администратора системы.
    </div>
}

<section class="card mb-4" aria-labelledby="user-create-heading">
    <div class="card-header">
        <h2 id="user-create-heading" class="h5 mb-0">@(isFirstUser ? "Первый администратор" : "Создать пользователя")</h2>
    </div>
    <div class="card-body">
        <EditForm @key="createUserEditContext" EditContext="createUserEditContext" OnValidSubmit="CreateUserAsync" FormName="user-create-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="user-full-name">ФИО</label>
                <InputText id="user-full-name" class="form-control" @bind-Value="newUser.FullName" />
                <ValidationMessage For="@(() => newUser.FullName)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="user-login">Логин</label>
                <InputText id="user-login" class="form-control" autocomplete="username" @bind-Value="newUser.UserName" />
                <ValidationMessage For="@(() => newUser.UserName)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="user-password">Пароль</label>
                <InputText id="user-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="newUser.Password" />
                <div class="form-text">Минимум 8 символов.</div>
                <ValidationMessage For="@(() => newUser.Password)" />
            </div>

            @if (isFirstUser)
            {
                <input type="hidden" name="Role" value="Admin" />
                <p class="mb-3"><strong>Роль:</strong> Администратор</p>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label" for="user-role">Роль</label>
                    <InputSelect id="user-role" class="form-select" @bind-Value="newUser.Role">
                        <option value="@UserRole.Admin">Администратор</option>
                        <option value="@UserRole.Employee">Сотрудник</option>
                    </InputSelect>
                </div>
            }

            <button type="submit" class="btn btn-primary me-2" disabled="@isSaving">
                @(isSaving ? "Сохранение..." : "Создать пользователя")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearCreateForm" disabled="@isSaving">
                Очистить
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(createMessage))
        {
            <div class="alert @(createSucceeded ? "alert-success" : "alert-danger") mt-3 mb-0" role="alert">
                @createMessage
            </div>
        }
    </div>
</section>

<h2 class="h4">Список сотрудников</h2>
<section class="card mb-3" aria-label="Фильтры сотрудников">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-4">
                <label class="form-label" for="user-search-filter">Поиск по ФИО или логину</label>
                <input id="user-search-filter" class="form-control" type="search" @bind="userSearch" @bind:event="oninput" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label" for="user-role-filter">Роль</label>
                <select id="user-role-filter" class="form-select" @bind="roleFilter">
                    <option value="all">Все роли</option>
                    <option value="admin">Администраторы</option>
                    <option value="employee">Сотрудники</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label" for="user-state-filter">Состояние</label>
                <select id="user-state-filter" class="form-select" @bind="archiveFilter">
                    <option value="all">Все</option>
                    <option value="active">Активные</option>
                    <option value="archived">Архивные</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetUserFilters">Сбросить</button>
            </div>
        </div>
    </div>
</section>
@if (users.Count == 0)
{
    <p class="text-muted">Список пока пуст.</p>
}
else if (!FilteredUsers.Any())
{
    <p class="text-muted">Сотрудники по заданным фильтрам не найдены.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">ФИО</th>
                    <th scope="col">Логин</th>
                    <th scope="col">Роль</th>
                    <th scope="col">Статус</th>
                    <th scope="col">Создан</th>
                    <th scope="col">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in FilteredUsers)
                {
                    <tr @key="user.Id">
                        <td>
                            <input class="form-control" aria-label="ФИО сотрудника" @bind="user.FullName" />
                        </td>
                        <td>
                            <input class="form-control" aria-label="Логин сотрудника" @bind="user.UserName" />
                        </td>
                        <td>@GetRoleName(user.Role)</td>
                        <td>
                            <span class="badge @(user.IsArchived ? "text-bg-dark" : user.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(user.IsArchived ? "В архиве" : user.IsActive ? "Активен" : "Неактивен")
                            </span>
                        </td>
                        <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveUserAsync(user)" disabled="@isSaving">
                                    Сохранить
                                </button>
                                @if (user.IsArchived)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => RestoreUserAsync(user)" disabled="@isSaving">
                                        Восстановить
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleUserAsync(user)" disabled="@isSaving">
                                        @(user.IsActive ? "Деактивировать" : "Активировать")
                                    </button>
                                    @if (user.IsActive)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ArchiveUserAsync(user)" disabled="@(isSaving || user.Id == currentUserId)" title="@(user.Id == currentUserId ? "Нельзя архивировать собственную учётную запись" : null)">
                                            В архив
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => ResetPasswordAsync(user)" disabled="@(isSaving || user.Id == currentUserId || !user.IsActive)" title="@(user.Id == currentUserId ? "Нельзя сбросить собственный пароль" : !user.IsActive ? "Нельзя сбросить пароль неактивного пользователя" : null)">
                                        Сбросить пароль
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUserAsync(user)" disabled="@(isSaving || user.Id == currentUserId)" title="@(user.Id == currentUserId ? "Нельзя удалить собственную учётную запись" : null)">
                                    Удалить
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrWhiteSpace(listMessage))
{
    <div class="alert @(listOperationSucceeded ? "alert-success" : "alert-danger")" role="alert">
        @listMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(temporaryPassword))
{
    <div class="alert alert-warning" role="alert">
        <p>Временный пароль для @temporaryPasswordUserName. Он действует 15 минут и будет показан только сейчас:</p>
        <code id="temporary-password">@temporaryPassword</code>
        <div class="mt-2 d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="CopyTemporaryPasswordAsync">Копировать пароль</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DismissTemporaryPassword">Скрыть пароль</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(copyMessage))
        {
            <div class="mt-2" role="status">@copyMessage</div>
        }
    </div>
}

@code {
    private List<UserListItem> users = [];
    private UserCreateModel newUser = new();
    private EditContext createUserEditContext = default!;
    private bool isFirstUser;
    private bool isSaving;
    private int currentUserId;
    private string userSearch = string.Empty;
    private string roleFilter = "all";
    private string archiveFilter = "all";
    private bool createSucceeded;
    private bool listOperationSucceeded;
    private string? createMessage;
    private string? listMessage;
    private string? temporaryPassword;
    private string? temporaryPasswordUserName;
    private string? copyMessage;

    private IEnumerable<UserListItem> FilteredUsers
    {
        get
        {
            var search = userSearch.Trim();
            return users.Where(user =>
                (string.IsNullOrEmpty(search) ||
                    user.FullName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    user.UserName.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
                (roleFilter == "all" ||
                    roleFilter == "admin" && user.Role == UserRole.Admin ||
                    roleFilter == "employee" && user.Role == UserRole.Employee) &&
                (archiveFilter == "all" ||
                    archiveFilter == "archived" && user.IsArchived ||
                    archiveFilter == "active" && user.IsActive && !user.IsArchived));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        int.TryParse(authenticationState.User.FindFirst("UserId")?.Value, out currentUserId);
        await LoadUsersAsync();
        createUserEditContext = new EditContext(newUser);
    }

    private async Task LoadUsersAsync()
    {
        users = await UserService.GetUsersAsync();
        isFirstUser = users.Count == 0;
        if (isFirstUser)
        {
            newUser.Role = UserRole.Admin;
        }
    }

    private void ResetUserFilters()
    {
        userSearch = string.Empty;
        roleFilter = "all";
        archiveFilter = "all";
    }

    private void ClearCreateForm()
    {
        newUser = new UserCreateModel
        {
            Role = isFirstUser ? UserRole.Admin : UserRole.Employee
        };
        createUserEditContext = new EditContext(newUser);
        createMessage = null;
        createSucceeded = false;
    }

    private async Task CreateUserAsync()
    {
        isSaving = true;
        createMessage = null;

        try
        {
            if (isFirstUser)
            {
                newUser.Role = UserRole.Admin;
            }

            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            createSucceeded = await UserService.AddUserAsync(newUser, authenticationState.User);
            if (!createSucceeded)
            {
                var userName = newUser.UserName.Trim();
                var existingUsers = await UserService.GetUsersAsync();
                createMessage = existingUsers.Any(user =>
                    string.Equals(user.UserName, userName, StringComparison.Ordinal))
                    ? "Пользователь с таким логином уже существует"
                    : "Не удалось создать пользователя. Проверьте данные, права администратора и активность своей учётной записи.";
                return;
            }

            createMessage = isFirstUser
                ? "Первый администратор создан."
                : "Пользователь создан.";
            newUser = new UserCreateModel { Role = UserRole.Employee };
            await LoadUsersAsync();
            createUserEditContext = new EditContext(newUser);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveUserAsync(UserListItem user)
    {
        isSaving = true;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            listOperationSucceeded = await UserService.UpdateUserAsync(
                user.Id,
                user.FullName,
                user.UserName,
                authenticationState.User);
            listMessage = listOperationSucceeded
                ? "Данные пользователя сохранены."
                : "Не удалось сохранить данные. Проверьте ФИО, длину и уникальность логина, а также актуальность прав администратора.";
            if (listOperationSucceeded)
            {
                await LoadUsersAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleUserAsync(UserListItem user)
    {
        isSaving = true;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            listOperationSucceeded = await UserService.SetUserActiveAsync(
                user.Id,
                !user.IsActive,
                authenticationState.User);
            listMessage = listOperationSucceeded
                ? user.IsActive ? "Пользователь деактивирован. Связанные заявки и взаимодействия сохранены." : "Пользователь активирован."
                : "Не удалось изменить статус пользователя. Проверьте права администратора и активность своей учётной записи.";
            if (listOperationSucceeded)
            {
                await LoadUsersAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ArchiveUserAsync(UserListItem user)
    {
        isSaving = true;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            listOperationSucceeded = await UserService.ArchiveUserAsync(user.Id, authenticationState.User);
            listMessage = listOperationSucceeded
                ? "Пользователь перемещён в архив. Связанные заявки и взаимодействия сохранены."
                : user.Role == UserRole.Admin && users.Count(candidate =>
                    candidate.Role == UserRole.Admin && candidate.IsActive && !candidate.IsArchived) <= 1
                    ? "Нельзя архивировать последнего активного администратора."
                    : "Не удалось архивировать пользователя. Проверьте права администратора и активность учётной записи.";

            if (listOperationSucceeded)
            {
                await LoadUsersAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RestoreUserAsync(UserListItem user)
    {
        isSaving = true;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            listOperationSucceeded = await UserService.RestoreUserAsync(user.Id, authenticationState.User);
            listMessage = listOperationSucceeded
                ? "Пользователь восстановлен из архива."
                : "Не удалось восстановить пользователя. Проверьте права администратора и активность учётной записи.";

            if (listOperationSucceeded)
            {
                await LoadUsersAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteUserAsync(UserListItem user)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Удалить пользователя {user.FullName} ({user.UserName})? Это действие необратимо.");
        if (!confirmed)
        {
            return;
        }

        isSaving = true;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            listOperationSucceeded = await UserService.DeleteUserAsync(user.Id, authenticationState.User);
            if (listOperationSucceeded)
            {
                listMessage = "Пользователь удалён.";
                await LoadUsersAsync();
            }
            else if (await UserService.HasUserHistoryAsync(user.Id, authenticationState.User))
            {
                listMessage = "У сотрудника есть связанные заявки или взаимодействия. Его можно только архивировать.";
            }
            else
            {
                listMessage = "Не удалось удалить пользователя. Проверьте права администратора и ограничения безопасности.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetPasswordAsync(UserListItem user)
    {
        isSaving = true;
        temporaryPassword = null;
        temporaryPasswordUserName = null;
        copyMessage = null;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            temporaryPassword = await UserService.ResetUserPasswordAsync(user.Id, authenticationState.User);
            listOperationSucceeded = temporaryPassword is not null;
            if (listOperationSucceeded)
            {
                temporaryPasswordUserName = user.UserName;
                listMessage = "Временный пароль создан. Передайте его сотруднику безопасным способом.";
            }
            else
            {
                listMessage = "Не удалось сбросить пароль. Проверьте, что вы администратор, цель — другой активный пользователь, и ваша учётная запись актуальна.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CopyTemporaryPasswordAsync()
    {
        if (temporaryPassword is null)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", temporaryPassword);
            copyMessage = "Пароль скопирован.";
        }
        catch (JSException)
        {
            copyMessage = "Не удалось скопировать пароль. Скопируйте его вручную.";
        }
    }

    private void DismissTemporaryPassword()
    {
        temporaryPassword = null;
        temporaryPasswordUserName = null;
        copyMessage = null;
    }

    private static string GetRoleName(UserRole role) => role switch
    {
        UserRole.Admin => "Администратор",
        UserRole.Employee => "Сотрудник",
        _ => role.ToString()
    };
}
