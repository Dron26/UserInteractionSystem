@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using UserInteractionSystem.Application.Models
@using UserInteractionSystem.Domain.Enums
@inject UserInteractionSystem.Application.Services.UserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Сотрудники</PageTitle>

<h1>Сотрудники</h1>

@if (isFirstUser)
{
    <div class="alert alert-info" role="status">
        Пользователей пока нет. Создайте первого администратора системы.
    </div>
}

<section class="card mb-4" aria-labelledby="user-create-heading">
    <div class="card-header">
        <h2 id="user-create-heading" class="h5 mb-0">@(isFirstUser ? "Первый администратор" : "Создать пользователя")</h2>
    </div>
    <div class="card-body">
        <EditForm Model="newUser" OnValidSubmit="CreateUserAsync" FormName="user-create-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="user-full-name">ФИО</label>
                <InputText id="user-full-name" class="form-control" @bind-Value="newUser.FullName" />
                <ValidationMessage For="@(() => newUser.FullName)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="user-login">Логин</label>
                <InputText id="user-login" class="form-control" autocomplete="username" @bind-Value="newUser.UserName" />
                <ValidationMessage For="@(() => newUser.UserName)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="user-password">Пароль</label>
                <InputText id="user-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="newUser.Password" />
                <div class="form-text">Минимум 8 символов.</div>
                <ValidationMessage For="@(() => newUser.Password)" />
            </div>

            @if (isFirstUser)
            {
                <input type="hidden" name="Role" value="Admin" />
                <p class="mb-3"><strong>Роль:</strong> Администратор</p>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label" for="user-role">Роль</label>
                    <InputSelect id="user-role" class="form-select" @bind-Value="newUser.Role">
                        <option value="@UserRole.Admin">Администратор</option>
                        <option value="@UserRole.Employee">Сотрудник</option>
                    </InputSelect>
                </div>
            }

            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "Сохранение..." : "Создать пользователя")
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(createMessage))
        {
            <div class="alert @(createSucceeded ? "alert-success" : "alert-danger") mt-3 mb-0" role="alert">
                @createMessage
            </div>
        }
    </div>
</section>

<h2 class="h4">Список сотрудников</h2>
@if (users.Count == 0)
{
    <p class="text-muted">Список пока пуст.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">ФИО</th>
                    <th scope="col">Логин</th>
                    <th scope="col">Роль</th>
                    <th scope="col">Статус</th>
                    <th scope="col">Создан</th>
                    <th scope="col">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr @key="user.Id">
                        <td>
                            <input class="form-control" aria-label="ФИО сотрудника" @bind="user.FullName" />
                        </td>
                        <td>
                            <input class="form-control" aria-label="Логин сотрудника" @bind="user.UserName" />
                        </td>
                        <td>@GetRoleName(user.Role)</td>
                        <td>
                            <span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(user.IsActive ? "Активен" : "Неактивен")
                            </span>
                        </td>
                        <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveUserAsync(user)" disabled="@isSaving">
                                    Сохранить
                                </button>
                                <button type="button" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleUserAsync(user)" disabled="@isSaving">
                                    @(user.IsActive ? "Деактивировать" : "Активировать")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => ResetPasswordAsync(user)" disabled="@(isSaving || user.Id == currentUserId || !user.IsActive)" title="@(user.Id == currentUserId ? "Нельзя сбросить собственный пароль" : !user.IsActive ? "Нельзя сбросить пароль неактивного пользователя" : null)">
                                    Сбросить пароль
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrWhiteSpace(listMessage))
{
    <div class="alert @(listOperationSucceeded ? "alert-success" : "alert-danger")" role="alert">
        @listMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(temporaryPassword))
{
    <div class="alert alert-warning" role="alert">
        <p>Временный пароль для @temporaryPasswordUserName. Он действует 15 минут и будет показан только сейчас:</p>
        <code id="temporary-password">@temporaryPassword</code>
        <div class="mt-2 d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="CopyTemporaryPasswordAsync">Копировать пароль</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DismissTemporaryPassword">Скрыть пароль</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(copyMessage))
        {
            <div class="mt-2" role="status">@copyMessage</div>
        }
    </div>
}

@code {
    private List<UserListItem> users = [];
    private UserCreateModel newUser = new();
    private bool isFirstUser;
    private bool isSaving;
    private int currentUserId;
    private bool createSucceeded;
    private bool listOperationSucceeded;
    private string? createMessage;
    private string? listMessage;
    private string? temporaryPassword;
    private string? temporaryPasswordUserName;
    private string? copyMessage;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        int.TryParse(authenticationState.User.FindFirst("UserId")?.Value, out currentUserId);
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await UserService.GetUsersAsync();
        isFirstUser = users.Count == 0;
        if (isFirstUser)
        {
            newUser.Role = UserRole.Admin;
        }
    }

    private async Task CreateUserAsync()
    {
        isSaving = true;
        createMessage = null;

        try
        {
            if (isFirstUser)
            {
                newUser.Role = UserRole.Admin;
            }

            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            createSucceeded = await UserService.AddUserAsync(newUser, authenticationState.User);
            if (!createSucceeded)
            {
                createMessage = "Не удалось создать пользователя. Проверьте данные, права администратора и активность своей учётной записи.";
                return;
            }

            createMessage = isFirstUser
                ? "Первый администратор создан."
                : "Пользователь создан.";
            newUser = new UserCreateModel { Role = UserRole.Employee };
            await LoadUsersAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveUserAsync(UserListItem user)
    {
        isSaving = true;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            listOperationSucceeded = await UserService.UpdateUserAsync(
                user.Id,
                user.FullName,
                user.UserName,
                authenticationState.User);
            listMessage = listOperationSucceeded
                ? "Данные пользователя сохранены."
                : "Не удалось сохранить данные. Проверьте ФИО, длину и уникальность логина, а также актуальность прав администратора.";
            if (listOperationSucceeded)
            {
                await LoadUsersAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleUserAsync(UserListItem user)
    {
        isSaving = true;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            listOperationSucceeded = await UserService.SetUserActiveAsync(
                user.Id,
                !user.IsActive,
                authenticationState.User);
            listMessage = listOperationSucceeded
                ? user.IsActive ? "Пользователь деактивирован. Связанные заявки и взаимодействия сохранены." : "Пользователь активирован."
                : "Не удалось изменить статус пользователя. Проверьте права администратора и активность своей учётной записи.";
            if (listOperationSucceeded)
            {
                await LoadUsersAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetPasswordAsync(UserListItem user)
    {
        isSaving = true;
        temporaryPassword = null;
        temporaryPasswordUserName = null;
        copyMessage = null;
        listMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            temporaryPassword = await UserService.ResetUserPasswordAsync(user.Id, authenticationState.User);
            listOperationSucceeded = temporaryPassword is not null;
            if (listOperationSucceeded)
            {
                temporaryPasswordUserName = user.UserName;
                listMessage = "Временный пароль создан. Передайте его сотруднику безопасным способом.";
            }
            else
            {
                listMessage = "Не удалось сбросить пароль. Проверьте, что вы администратор, цель — другой активный пользователь, и ваша учётная запись актуальна.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CopyTemporaryPasswordAsync()
    {
        if (temporaryPassword is null)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", temporaryPassword);
            copyMessage = "Пароль скопирован.";
        }
        catch (JSException)
        {
            copyMessage = "Не удалось скопировать пароль. Скопируйте его вручную.";
        }
    }

    private void DismissTemporaryPassword()
    {
        temporaryPassword = null;
        temporaryPasswordUserName = null;
        copyMessage = null;
    }

    private static string GetRoleName(UserRole role) => role switch
    {
        UserRole.Admin => "Администратор",
        UserRole.Employee => "Сотрудник",
        _ => role.ToString()
    };
}
