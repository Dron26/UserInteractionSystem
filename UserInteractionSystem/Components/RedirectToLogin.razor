@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var sessionWasInvalidated = AuthenticationStateProvider is UserRevalidatingAuthenticationStateProvider provider &&
            provider.SessionWasInvalidated;
        var destination = sessionWasInvalidated ? "/login?session=invalid" : "/login";
        Navigation.NavigateTo(destination, forceLoad: true);
    }
}
